{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grok-work-receipt.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "job_id",
    "transport",
    "objective_hash",
    "changed_files",
    "tests",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {
      "const": "grok-work-receipt.v1"
    },
    "status": {
      "enum": [
        "completed",
        "no_changes",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "job_id": {
      "type": "string"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport": {
      "enum": [
        "legacy",
        "stdio",
        "websocket"
      ]
    },
    "objective_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths this run is responsible for: files changed against base_ref whose content also differs from the pre-run snapshot. Acceptance is judged on this list."
    },
    "full_changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every path differing from base_ref, including work the lane already carried before this run. Always a superset of changed_files."
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diffstat": {
      "type": "string"
    },
    "unified_diff": {
      "type": "string",
      "description": "Bounded diff against base_ref, so it covers full_changed_files -- not changed_files. The two are deliberately different slices: do not expect them to match 1:1."
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null when the source cannot support a verdict."
          },
          "returncode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "bridge-verifier",
              "agent-reported"
            ],
            "description": "Only bridge-verifier counts as evidence. agent-reported is the agent's own claim, whose exit code belongs to the last statement of a shell chain."
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_alive_after_shutdown": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "tests_skipped_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NOT_A_WRITE_ROLE",
        "CANCELLED",
        "NO_CHANGES",
        "NO_TEST_COMMANDS",
        null
      ],
      "description": "Why tests is empty. null means the verifier ran and these are its results."
    }
  }
}
