# HTTP transport settings for grok-delegate
# Copy outside the repo and fill in. Never commit real tokens.
# Unofficial community project — not an official xAI/Grok product.
# Bearer is an operator-generated secret — NOT Grok OAuth / API keys.

GROK_DELEGATE_HTTP_HOST=127.0.0.1
GROK_DELEGATE_HTTP_PORT=8765

# Generate: openssl rand -hex 32 > /path/to/grok-delegate.token
# Set only ONE of TOKEN or TOKEN_FILE.
# GROK_DELEGATE_HTTP_TOKEN=
GROK_DELEGATE_HTTP_TOKEN_FILE=<TOKEN_FILE>

GROK_DELEGATE_HTTP_MAX_INFLIGHT=16

# Policy (placeholders)
GROK_DELEGATE_ALLOWED_ROOTS=<PROJECT_ROOT>
GROK_DELEGATE_LANES_PARENT=<LANES_PARENT>
GROK_DELEGATE_JOBS_DIR=<JOBS_DIR>
GROK_DELEGATE_ECONOMY=1
