# grok-delegate — non-secret environment template
# Copy to a local .env only if your host/tooling loads it; do not commit real paths
# that identify private machines if you prefer privacy. Never put secrets here.
#
# NEVER set in this file or any MCP host JSON:
#   GROK_AGENT_SECRET
#   OAuth tokens / refresh tokens
#   API keys / bearer tokens

# Exact project root allowlist (; -separated absolute paths, or a JSON array string)
GROK_DELEGATE_ALLOWED_ROOTS=<PROJECT_ROOT>

# Single-root pin (used when ALLOWED_ROOTS is unset)
GROK_DELEGATE_REPO_ROOT=<PROJECT_ROOT>

# Parent directory for external git worktrees (prefer outside the source repo)
GROK_DELEGATE_LANES_PARENT=<LANES_PARENT>

# Durable job records directory
GROK_DELEGATE_JOBS_DIR=<JOBS_DIR>

# Optional: grok binary name or absolute path (grok / grok.exe only)
# GROK_DELEGATE_BIN=grok

# Optional: sandbox profile override (off | workspace | devbox | read-only | strict)
# GROK_DELEGATE_SANDBOX=workspace

# Optional: concurrency (1–2) and queue depth (1–32)
# GROK_DELEGATE_CONCURRENCY=1
# GROK_DELEGATE_MAX_QUEUED=8

# Optional: git timeouts (seconds)
# GROK_DELEGATE_GIT_TIMEOUT_SECONDS=60
# GROK_DELEGATE_GIT_CHECKOUT_TIMEOUT_SECONDS=600

# Optional: logging (never write MCP JSON-RPC to stdout)
# GROK_DELEGATE_LOG_FILE=<JOBS_DIR>/grok-delegate.log
# GROK_DELEGATE_LOG_LEVEL=INFO

# Optional advanced: loopback WebSocket endpoint for an operator-run daemon
# (secret must be process-only — do not put GROK_AGENT_SECRET in this file)
# GROK_DELEGATE_WS_ENDPOINT=ws://127.0.0.1:<PORT>/ws

# Only if package is not installed editable
# PYTHONPATH=<REPO_PATH>
